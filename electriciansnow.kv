#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import TileButton nintendo_widgets.TileButton
#:import HeroCard nintendo_widgets.HeroCard
#:import PillButton nintendo_widgets.PillButton
#:import PriceTicker nintendo_widgets.PriceTicker
#:import StyledTextInput nintendo_widgets.StyledTextInput
#:import SWITCH_RED nintendo_widgets.SWITCH_RED
#:import SWITCH_BLUE nintendo_widgets.SWITCH_BLUE
#:import MARIO_YELLOW nintendo_widgets.MARIO_YELLOW
#:import LUIGI_GREEN nintendo_widgets.LUIGI_GREEN
#:import STAR_PURPLE nintendo_widgets.STAR_PURPLE
#:import NAVY nintendo_widgets.NAVY
#:import CREAM nintendo_widgets.CREAM


# ----- Home: Switch-style tile menu --------------------------------------
<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(18)
        spacing: dp(14)

        # Title row
        BoxLayout:
            size_hint_y: None
            height: dp(72)
            orientation: 'horizontal'
            spacing: dp(8)

            Label:
                text: "[size=44]⚡[/size]"
                markup: True
                size_hint_x: None
                width: dp(56)

            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: "Electricians NOW"
                    font_size: dp(30)
                    bold: True
                    color: NAVY
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    text: "Same-day service. Tap a tile to start."
                    font_size: dp(15)
                    color: 0.35, 0.35, 0.4, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

        # Address hero card
        HeroCard:
            id: address_card
            size_hint_y: None
            height: dp(180)
            orientation: 'vertical'
            padding: dp(16)
            spacing: dp(8)

            Label:
                text: "Service address"
                size_hint_y: None
                height: dp(26)
                font_size: dp(17)
                bold: True
                color: NAVY
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(50)

                TextInput:
                    id: address_input
                    text: root.address
                    on_text: root.address_text_changed(self.text)
                    on_focus: root.save_address(self.text) if not self.focus else None
                    multiline: False
                    hint_text: "Start typing your address..."
                    font_size: dp(19)
                    padding: [dp(10), dp(12), dp(10), dp(12)]
                    background_color: 0.96, 0.96, 0.97, 1
                    foreground_color: NAVY
                    cursor_color: NAVY

            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)

                PillButton:
                    text: "\U0001F4CD  Use current location"
                    bg_color: SWITCH_BLUE
                    font_size: dp(16)
                    on_release: root.use_current_location()

            Label:
                text: root.locating
                size_hint_y: None
                height: dp(22) if root.locating else 0
                opacity: 1 if root.locating else 0
                font_size: dp(14)
                color: 0.4, 0.4, 0.5, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # 2x2 tile grid
        GridLayout:
            cols: 2
            spacing: dp(14)
            row_force_default: False
            row_default_height: 0

            TileButton:
                bg_color: SWITCH_RED
                icon: "\U0001F4A1"
                label: "Get Estimate"
                on_release: root.go_to('estimate')

            TileButton:
                bg_color: LUIGI_GREEN
                icon: "\U0001F4C5"
                label: "Schedule"
                on_release: root.go_to('schedule')

            TileButton:
                bg_color: MARIO_YELLOW
                icon: "\U0001F4AC"
                label: "Ask Expert"
                on_release: root.go_to('chat')

            TileButton:
                bg_color: STAR_PURPLE
                icon: "\U0001F4CB"
                label: "My Bookings"
                on_release: root.go_to('bookings')

        # Footer
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            orientation: 'horizontal'

            Label:
                text: "Licensed · Insured · 24/7"
                font_size: dp(13)
                color: 0.4, 0.4, 0.45, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                text: "Logs"
                size_hint_x: None
                width: dp(60)
                font_size: dp(13)
                background_color: 0.85, 0.85, 0.85, 1
                color: 0.3, 0.3, 0.35, 1
                on_release: app.root.current = 'logs'


# ----- Estimate: chunky range + tap-to-narrow questions -------------------
<EstimateScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            PillButton:
                text: "< Back"
                bg_color: 0.7, 0.7, 0.74, 1
                size_hint_x: None
                width: dp(110)
                font_size: dp(16)
                on_release: app.root.current = 'home'

            Label:
                text: "Get Estimate"
                font_size: dp(26)
                bold: True
                color: NAVY

        # Description input
        Label:
            text: "Describe the work:"
            size_hint_y: None
            height: dp(28)
            font_size: dp(17)
            color: NAVY
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: job_input
            text: root.job_description
            on_text: root.job_description = self.text
            multiline: True
            hint_text: "e.g., Replace bedroom ceiling fan"
            size_hint_y: None
            height: dp(120)
            font_size: dp(18)
            padding: [dp(12), dp(12)]
            background_color: 1, 1, 1, 1
            foreground_color: NAVY
            cursor_color: NAVY

        PillButton:
            text: "Get AI Estimate"
            bg_color: SWITCH_RED
            size_hint_y: None
            height: dp(58)
            font_size: dp(20)
            on_release: root.get_estimate()

        # Range display
        HeroCard:
            size_hint_y: None
            height: dp(120) if root.cost_high > 0 else 0
            opacity: 1 if root.cost_high > 0 else 0
            orientation: 'vertical'
            padding: dp(12)

            PriceTicker:
                low: root.cost_low
                high: root.cost_high
                size_hint_y: None
                height: dp(58)

            Label:
                text: ("Confidence: " + root.confidence) if root.confidence else ""
                size_hint_y: None
                height: dp(24)
                font_size: dp(14)
                color: 0.4, 0.4, 0.45, 1

            Label:
                text: root.explanation
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width - dp(20), None
                font_size: dp(16)
                color: NAVY
                halign: 'left'
                valign: 'top'

        # Clarifying questions area (populated dynamically by EstimateScreen)
        ScrollView:
            BoxLayout:
                id: questions_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
                padding: [0, dp(6), 0, dp(6)]

        # Schedule CTA
        PillButton:
            text: "Schedule this Service →"
            bg_color: LUIGI_GREEN
            size_hint_y: None
            height: dp(58) if root.cost_high > 0 else 0
            opacity: 1 if root.cost_high > 0 else 0
            disabled: root.cost_high <= 0
            font_size: dp(20)
            on_release: root.proceed_to_schedule()


# ----- Schedule -----------------------------------------------------------
<ScheduleScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            PillButton:
                text: "< Back"
                bg_color: 0.7, 0.7, 0.74, 1
                size_hint_x: None
                width: dp(110)
                font_size: dp(16)
                on_release: app.root.current = 'estimate'

            Label:
                text: "Schedule"
                font_size: dp(26)
                bold: True
                color: NAVY

        Label:
            text: app.get_estimate_summary()
            size_hint_y: None
            height: dp(36)
            font_size: dp(18)
            color: LUIGI_GREEN[0], LUIGI_GREEN[1], LUIGI_GREEN[2], 1
            bold: True

        Label:
            text: "Date"
            size_hint_y: None
            height: dp(28)
            font_size: dp(17)
            color: NAVY
            halign: 'left'
            text_size: self.size

        Spinner:
            id: date_spinner
            text: root.selected_date
            values: root.available_dates
            size_hint_y: None
            height: dp(54)
            font_size: dp(18)
            background_color: 1, 1, 1, 1
            color: NAVY
            on_text: root.selected_date = self.text

        Label:
            text: "Time"
            size_hint_y: None
            height: dp(28)
            font_size: dp(17)
            color: NAVY
            halign: 'left'
            text_size: self.size

        Spinner:
            id: time_spinner
            text: root.selected_time
            values: root.available_times
            size_hint_y: None
            height: dp(54)
            font_size: dp(18)
            background_color: 1, 1, 1, 1
            color: NAVY
            on_text: root.selected_time = self.text

        Label:
            text: "Address"
            size_hint_y: None
            height: dp(28)
            font_size: dp(17)
            color: NAVY
            halign: 'left'
            text_size: self.size

        TextInput:
            text: root.address
            on_text: root.address = self.text
            multiline: True
            hint_text: "Service address"
            size_hint_y: None
            height: dp(70)
            font_size: dp(18)
            padding: [dp(12), dp(12)]
            background_color: 1, 1, 1, 1
            foreground_color: NAVY
            cursor_color: NAVY

        Label:
            text: "Phone"
            size_hint_y: None
            height: dp(28)
            font_size: dp(17)
            color: NAVY
            halign: 'left'
            text_size: self.size

        TextInput:
            text: root.phone
            on_text: root.phone = self.text
            multiline: False
            hint_text: "(555) 123-4567"
            size_hint_y: None
            height: dp(54)
            font_size: dp(19)
            padding: [dp(12), dp(12)]
            background_color: 1, 1, 1, 1
            foreground_color: NAVY
            cursor_color: NAVY

        Widget:

        PillButton:
            text: "Confirm & Pay"
            bg_color: LUIGI_GREEN
            size_hint_y: None
            height: dp(60)
            font_size: dp(22)
            on_release: root.confirm_booking()


# ----- Bookings -----------------------------------------------------------
<BookingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            PillButton:
                text: "< Back"
                bg_color: 0.7, 0.7, 0.74, 1
                size_hint_x: None
                width: dp(110)
                font_size: dp(16)
                on_release: app.root.current = 'home'

            Label:
                text: "My Bookings"
                font_size: dp(26)
                bold: True
                color: NAVY

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: "Your upcoming appointments will appear here."
                    size_hint_y: None
                    height: dp(100)
                    font_size: dp(17)
                    color: 0.45, 0.45, 0.5, 1


# ----- Ask Expert chat ----------------------------------------------------
<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            PillButton:
                text: "< Back"
                bg_color: 0.7, 0.7, 0.74, 1
                size_hint_x: None
                width: dp(110)
                font_size: dp(16)
                on_release: app.root.current = 'home'

            Label:
                text: "Ask Expert"
                font_size: dp(26)
                bold: True
                color: NAVY

        ScrollView:
            id: chat_scroll
            Label:
                text: root.chat_history if root.chat_history else "Ask any question about electrical work, safety, or costs..."
                text_size: self.width - dp(20), None
                size_hint_y: None
                height: self.texture_size[1]
                padding: dp(10), dp(10)
                font_size: dp(17)
                halign: 'left'
                valign: 'top'
                color: NAVY

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)

            TextInput:
                id: chat_input
                text: root.user_message
                on_text: root.user_message = self.text
                multiline: False
                hint_text: "Type your question..."
                font_size: dp(18)
                background_color: 1, 1, 1, 1
                foreground_color: NAVY
                cursor_color: NAVY
                on_text_validate: root.send_message()

            PillButton:
                text: "Send"
                bg_color: SWITCH_BLUE
                size_hint_x: None
                width: dp(90)
                font_size: dp(18)
                on_release: root.send_message()


# ----- Logs ---------------------------------------------------------------
<LogsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            PillButton:
                text: "< Back"
                bg_color: 0.7, 0.7, 0.74, 1
                size_hint_x: None
                width: dp(110)
                font_size: dp(16)
                on_release: app.root.current = 'home'

            Label:
                text: "Diagnostics"
                font_size: dp(22)
                bold: True
                color: NAVY

        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)

            PillButton:
                text: "Refresh"
                bg_color: SWITCH_BLUE
                font_size: dp(16)
                on_release: root.refresh()

            PillButton:
                text: "Clear"
                bg_color: SWITCH_RED
                font_size: dp(16)
                on_release: root.clear_logs()

        ScrollView:
            Label:
                text: root.log_text
                text_size: self.width - dp(10), None
                size_hint_y: None
                height: self.texture_size[1]
                padding: dp(8), dp(8)
                font_size: dp(12)
                halign: 'left'
                valign: 'top'
                color: 0.1, 0.1, 0.15, 1
