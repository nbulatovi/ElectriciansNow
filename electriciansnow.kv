#:kivy 2.3.0
#:import dp kivy.metrics.dp

# Larger fonts throughout for accessibility (50+ users)
# Body: dp(20), buttons: dp(22), headers: dp(28-32)

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(18)
        spacing: dp(12)

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(110)
            orientation: 'vertical'

            Label:
                text: "Electricians NOW"
                font_size: dp(34)
                bold: True
                color: 0.2, 0.4, 0.8, 1

            Label:
                text: "AI estimates. Same-day booking."
                font_size: dp(17)
                color: 0.4, 0.4, 0.4, 1

        # Service address (front and center)
        Label:
            text: "Service address"
            size_hint_y: None
            height: dp(28)
            font_size: dp(18)
            bold: True
            halign: 'left'
            text_size: self.size
            color: 0.2, 0.2, 0.2, 1

        TextInput:
            id: address_input
            text: root.address
            on_text_validate: root.save_address(self.text)
            on_focus: root.save_address(self.text) if not self.focus else None
            multiline: False
            hint_text: "Enter your address"
            size_hint_y: None
            height: dp(54)
            font_size: dp(20)
            padding: [dp(12), dp(14)]

        Button:
            text: "Use current location"
            size_hint_y: None
            height: dp(48)
            font_size: dp(18)
            background_color: 0.4, 0.7, 0.9, 1
            on_press: root.use_current_location()

        Label:
            text: root.locating
            size_hint_y: None
            height: dp(22) if root.locating else 0
            opacity: 1 if root.locating else 0
            font_size: dp(15)
            color: 0.5, 0.5, 0.5, 1

        # Main actions
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(12)

            Button:
                text: "Get AI Estimate"
                font_size: dp(22)
                size_hint_y: None
                height: dp(64)
                background_color: 0.2, 0.6, 0.9, 1
                on_press: root.manager.current = 'estimate'

            Button:
                text: "Schedule Electrician"
                font_size: dp(22)
                size_hint_y: None
                height: dp(64)
                background_color: 0.2, 0.7, 0.3, 1
                on_press: root.manager.current = 'schedule'

            Button:
                text: "Ask a Question"
                font_size: dp(22)
                size_hint_y: None
                height: dp(64)
                background_color: 0.9, 0.6, 0.2, 1
                on_press: root.manager.current = 'chat'

            Button:
                text: "My Bookings"
                font_size: dp(22)
                size_hint_y: None
                height: dp(64)
                background_color: 0.6, 0.4, 0.8, 1
                on_press: root.manager.current = 'bookings'

        # Diagnostics + footer
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(80)

            Button:
                text: "Diagnostic Logs"
                size_hint_y: None
                height: dp(38)
                font_size: dp(15)
                background_color: 0.85, 0.85, 0.85, 1
                color: 0.3, 0.3, 0.3, 1
                on_press: root.manager.current = 'logs'

            Label:
                text: "Licensed & Insured  |  24/7 Service"
                font_size: dp(14)
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'


<EstimateScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            Button:
                text: "< Back"
                size_hint_x: 0.3
                font_size: dp(18)
                on_press: root.manager.current = 'home'

            Label:
                text: "Get Estimate"
                font_size: dp(24)
                bold: True

        Label:
            text: "Describe the electrical work needed:"
            size_hint_y: None
            height: dp(34)
            font_size: dp(18)
            halign: 'left'
            text_size: self.size

        TextInput:
            id: job_input
            text: root.job_description
            on_text: root.job_description = self.text
            multiline: True
            hint_text: "e.g., Replace bedroom ceiling fan with new model"
            size_hint_y: None
            height: dp(130)
            font_size: dp(19)
            padding: [dp(12), dp(12)]

        Button:
            text: "Get AI Estimate"
            size_hint_y: None
            height: dp(58)
            font_size: dp(22)
            background_color: 0.2, 0.6, 0.9, 1
            on_press: root.get_estimate()

        ScrollView:
            Label:
                text: root.estimate_result if root.estimate_result else "Enter a description and tap 'Get AI Estimate'"
                text_size: self.width - dp(20), None
                size_hint_y: None
                height: self.texture_size[1]
                padding: dp(10), dp(10)
                font_size: dp(18)
                halign: 'left'
                valign: 'top'
                color: 0.15, 0.15, 0.15, 1

        Button:
            text: f"Schedule Service - {root.cost_range}" if root.cost_range else "Schedule Service"
            size_hint_y: None
            height: dp(58)
            font_size: dp(20)
            background_color: 0.2, 0.7, 0.3, 1
            opacity: 1 if root.estimated_cost > 0 else 0
            disabled: root.estimated_cost <= 0
            on_press: root.proceed_to_schedule()


<ScheduleScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            Button:
                text: "< Back"
                size_hint_x: 0.3
                font_size: dp(18)
                on_press: root.manager.current = 'estimate'

            Label:
                text: "Schedule Visit"
                font_size: dp(24)
                bold: True

        Label:
            text: app.get_estimate_summary()
            size_hint_y: None
            height: dp(36)
            font_size: dp(18)
            color: 0.2, 0.6, 0.2, 1
            bold: True

        Label:
            text: "Date"
            size_hint_y: None
            height: dp(28)
            font_size: dp(18)
            halign: 'left'
            text_size: self.size

        Spinner:
            id: date_spinner
            text: root.selected_date
            values: root.available_dates
            size_hint_y: None
            height: dp(52)
            font_size: dp(19)
            on_text: root.selected_date = self.text

        Label:
            text: "Time"
            size_hint_y: None
            height: dp(28)
            font_size: dp(18)
            halign: 'left'
            text_size: self.size

        Spinner:
            id: time_spinner
            text: root.selected_time
            values: root.available_times
            size_hint_y: None
            height: dp(52)
            font_size: dp(19)
            on_text: root.selected_time = self.text

        Label:
            text: "Address"
            size_hint_y: None
            height: dp(28)
            font_size: dp(18)
            halign: 'left'
            text_size: self.size

        TextInput:
            text: root.address
            on_text: root.address = self.text
            multiline: True
            hint_text: "Service address"
            size_hint_y: None
            height: dp(70)
            font_size: dp(19)
            padding: [dp(12), dp(12)]

        Label:
            text: "Phone"
            size_hint_y: None
            height: dp(28)
            font_size: dp(18)
            halign: 'left'
            text_size: self.size

        TextInput:
            text: root.phone
            on_text: root.phone = self.text
            multiline: False
            hint_text: "(555) 123-4567"
            size_hint_y: None
            height: dp(52)
            font_size: dp(20)
            padding: [dp(12), dp(12)]

        Widget:

        Button:
            text: "Confirm & Pay"
            size_hint_y: None
            height: dp(60)
            background_color: 0.2, 0.7, 0.3, 1
            font_size: dp(22)
            on_press: root.confirm_booking()


<BookingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            Button:
                text: "< Back"
                size_hint_x: 0.3
                font_size: dp(18)
                on_press: root.manager.current = 'home'

            Label:
                text: "My Bookings"
                font_size: dp(24)
                bold: True

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

                Label:
                    text: "Your upcoming appointments will appear here."
                    size_hint_y: None
                    height: dp(100)
                    font_size: dp(18)
                    color: 0.5, 0.5, 0.5, 1


<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            Button:
                text: "< Back"
                size_hint_x: 0.3
                font_size: dp(18)
                on_press: root.manager.current = 'home'

            Label:
                text: "Ask an Expert"
                font_size: dp(24)
                bold: True

        ScrollView:
            id: chat_scroll
            Label:
                text: root.chat_history if root.chat_history else "Ask any question about electrical work, safety, or costs..."
                text_size: self.width - dp(20), None
                size_hint_y: None
                height: self.texture_size[1]
                padding: dp(10), dp(10)
                font_size: dp(18)
                halign: 'left'
                valign: 'top'

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)

            TextInput:
                id: chat_input
                text: root.user_message
                on_text: root.user_message = self.text
                multiline: False
                hint_text: "Type your question..."
                font_size: dp(19)
                on_text_validate: root.send_message()

            Button:
                text: "Send"
                size_hint_x: 0.28
                font_size: dp(20)
                background_color: 0.2, 0.6, 0.9, 1
                on_press: root.send_message()


<LogsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(54)

            Button:
                text: "< Back"
                size_hint_x: 0.3
                font_size: dp(18)
                on_press: root.manager.current = 'home'

            Label:
                text: "Diagnostic Logs"
                font_size: dp(22)
                bold: True

        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)

            Button:
                text: "Refresh"
                font_size: dp(16)
                background_color: 0.4, 0.7, 0.9, 1
                on_press: root.refresh()

            Button:
                text: "Clear"
                font_size: dp(16)
                background_color: 0.9, 0.4, 0.4, 1
                on_press: root.clear_logs()

        ScrollView:
            Label:
                text: root.log_text
                text_size: self.width - dp(10), None
                size_hint_y: None
                height: self.texture_size[1]
                padding: dp(8), dp(8)
                font_size: dp(13)
                halign: 'left'
                valign: 'top'
                font_name: 'RobotoMono-Regular' if self.font_name == 'Roboto' else self.font_name
                color: 0.1, 0.1, 0.1, 1
