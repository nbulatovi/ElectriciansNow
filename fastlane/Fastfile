default_platform(:ios)

platform :ios do
  desc "Revoke existing distribution certs and create fresh ones via match"
  lane :reset_signing do
    match_nuke(type: "distribution")
    match(type: "appstore")
  end

  desc "Build the iOS app"
  lane :build do
    gym(
      scheme: "ElectriciansNow",
      configuration: "Release",
      clean: true,
      export_method: "app-store"
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    build
    pilot(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy to App Store"
  lane :release do
    build
    deliver(
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end
